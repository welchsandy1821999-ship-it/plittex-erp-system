# === 1. СЕКРЕТЫ И КОНФИГУРАЦИИ ===
.env
.env.local
.env.*.local

# === 2. ЗАВИСИМОСТИ ===
node_modules/

# === 3. ПОЛЬЗОВАТЕЛЬСКИЕ ДАННЫЕ И ЗАГРУЗКИ ===
public/uploads/
!public/uploads/.gitkeep
public/saved_docs/*
!public/saved_docs/.gitkeep

# === 4. ЛОГИ ===
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# === 5. ВРЕМЕННЫЕ ФАЙЛЫ ===
*.tmp
*.temp
.cache/
tmp/

# === 6. БАЗЫ ДАННЫХ И БЭКАПЫ ===
db_backups/
backups/
postgres_data/
*.sql
!scripts/**/*.sql

# === 7. ДЕПЛОЙ (разовые скрипты не коммитить) ===
deploy/*
!deploy/deploy_all.js
!deploy/nginx-erp.conf

# === 8. СИСТЕМНЫЕ ФАЙЛЫ И РЕДАКТОРЫ ===
.idea/
.vscode/
.vs/
.agent/
.antigravity/
.gemini/
.DS_Store
Thumbs.db

# === 9. DOCKER (не используется) ===
