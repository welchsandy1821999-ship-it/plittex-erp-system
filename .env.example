# === ПЛИТТЕКС ERP — Environment Variables ===

# PostgreSQL Database (или отдельный пользователь приложения — см. scripts/create_plittex_db.sql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=plittex_app
DB_PASSWORD=your_password
DB_NAME=plittex_db

# Полный путь к pg_dump (обязательно на Windows Server, если bin PostgreSQL не в PATH).
# Пример: C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe
# Пусто = искать команду pg_dump в PATH.
PG_DUMP_PATH=

# Server
PORT=3000
NODE_ENV=development
FORCE_ALL_USERS_ADMIN=true
# Разрешённые origin для CORS и Socket.io (через запятую). Пусто = только http://localhost:3000 и http://127.0.0.1:3000
# CORS_ORIGIN=https://erp.example.com,https://app.example.com
CORS_ORIGIN=

# JWT Secret (generate a strong random key)
JWT_SECRET=your_jwt_secret_here

# Sentry Monitoring (optional — leave empty to disable)
SENTRY_DSN=your_dsn_here

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Опционально: HTTP/HTTPS-прокси для обхода блокировок api.telegram.org (@cypress/request: proxy).
# Пример: http://user:pass@127.0.0.1:8080  Для SOCKS5 может потребоваться отдельный туннель/агент.
TG_PROXY_URL=

# Dev Mode (set to 'true' to enable /api/dev routes)
DEV_MODE=false
